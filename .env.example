# VEND/AI — Environment Variables
# Copy to .env.local and fill in values for local dev. Vercel: set via dashboard.

# ── Required ─────────────────────────────────────────────────────────────
# Neon Postgres connection string (from console.neon.tech)
DATABASE_URL=

# JWT signing secret. Generate: `openssl rand -base64 32` or `npx auth secret`
JWT_SECRET=

# Anthropic API key for v1 starter tools (Editorial Rewriter, URL → Bullets)
ANTHROPIC_API_KEY=

# Resend API key for magic-link email delivery (optional in dev — see below)
RESEND_API_KEY=

# ── Recommended ──────────────────────────────────────────────────────────
# Sender address for magic-link emails (must be verified in Resend)
RESEND_FROM=noreply@vendai.com

# Email that becomes operator on first sign-in (admin panel access)
OPERATOR_EMAIL=

# Public site URL (used in magic-link callbacks, OG metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public admin URL (the hostname or path for the operator panel)
NEXT_PUBLIC_ADMIN_HOST=control.localhost:3000

# ── Reserved for v1.1+ ───────────────────────────────────────────────────
# Stripe (pack purchases — not wired in v1)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# OpenRouter (LLM aggregator — wire when a non-Claude tool ships)
# OPENROUTER_API_KEY=

# ElevenLabs (voice tools — v1.1+)
# ELEVENLABS_API_KEY=

# ── Dev fallback behavior ────────────────────────────────────────────────
# If RESEND_API_KEY is empty, magic links print to server console with prefix [AUTH-DEV-LINK].
# If JWT_SECRET is empty, falls back to a fixed dev secret (insecure — set this in prod).
